# ~/.config/ghostty/config
# Custom Ghostty config (user-provided + safe defaults)
# - Theme: vesper
# - Includes font, leading, theme fragments and shader
# - Keybindings tuned for dvorak + quick terminal toggle
# - Visual tweaks: underline, alpha blending, cursor, padding

# Basic theme
theme = "vesper"

# Visual adjustments
adjust-underline-position = 8
adjust-underline-thickness = 2
alpha-blending = "linear-corrected"
font-thicken = true
cursor-invert-fg-bg = true
custom-shader-animation = "always"
macos-icon = "custom-style"
macos-icon-frame = "aluminum"
macos-icon-ghost-color = "86e1fc"
macos-icon-screen-color = "222436"
macos-option-as-alt = "true"
mouse-hide-while-typing = "true"
unfocused-split-fill = "#000000"

# Font & layout defaults (safe fallbacks)
font-family = "JetBrains Mono Nerd Font"
font-size = 14
window-padding-x = 20
window-padding-y = 18
corner-radius = 12
background-opacity = 0.92
background-blur = true

# Keybindings
keybind = "global:super+ctrl+.=toggle_quick_terminal"

# Dvorak-safe unbinds (map names to physical keys)
keybind = super++=unbind
keybind = super+equal=unbind
keybind = super+bracket_left=unbind
keybind = super+shift+bracket_left=unbind
keybind = super+bracket_right=unbind
keybind = super+shift+bracket_right=unbind

# Bindings mapped to characters (work across layouts)
keybind = super+==increase_font_size:1
keybind = super+[=goto_split:previous
keybind = super+shift+[=previous_tab
keybind = super+]=goto_split:next
keybind = super+shift+]=next_tab

# Optional helper: mouse hide while typing (keeps UI clean)
mouse-hide-while-typing = "true"

# Config file fragments (you can switch these via your gc function)
config-file = "font/monolisa"
config-file = "leading/default"
config-file = "theme/minihues-winter"
config-file = "opacity/100%"
config-file = "shader/glitchy"

# Shell integration & behavior
shell-integration = "zsh"
shell-integration-features = "no-cursor"
copy-on-select = "clipboard"
clipboard-trim-trailing-spaces = true
window-save-state = always

# macOS specifics (if on macOS)
macos-titlebar-style = "tabs"
macos-window-shadow = false
use-metal = true

# End of file
