# Ghostty — Vesper
# Verified against Ghostty 1.3.1. Validate: ghostty +validate-config
# Reload: ⌘⇧,   Defaults: ghostty +show-config --default --docs

# ── Theme ────────────────────────────────────────────────────────────
# Built-in Vesper; the overrides below win regardless of order.
theme = Vesper
background = #101010
foreground = #E6E1DA
cursor-color = #FFC799
cursor-text = #101010
# Built-in selection is 2.0:1 contrast; this is 9.7:1.
selection-background = #3A3226
selection-foreground = #E6E1DA
# Built-in color0 equals the background, making "black" text invisible.
palette = 0=#232323
split-divider-color = #232323

# ── Font ─────────────────────────────────────────────────────────────
# Ligature-capable variant (the NL variant disables them). calt/liga are on by default.
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
adjust-cell-height = 10%

# ── Window ───────────────────────────────────────────────────────────
# "tabs" (tab bar inside the titlebar) is documented as untested past macOS 14
# and renders a collapsed tab pill on macOS 27. "transparent" blends the
# titlebar into the background and uses the native tab bar.
macos-titlebar-style = transparent
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-save-state = always
window-inherit-working-directory = true
unfocused-split-opacity = 0.85
resize-overlay = never
confirm-close-surface = true

# ── Cursor ───────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false

# ── Input / mouse ────────────────────────────────────────────────────
# Left ⌥ acts as Alt (word jumps, fzf ⌥C); right ⌥ still types special characters.
macos-option-as-alt = left
mouse-hide-while-typing = true

# ── Clipboard / links ────────────────────────────────────────────────
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true
copy-on-select = true
link-url = true

# ── Scrollback (bytes) ───────────────────────────────────────────────
scrollback-limit = 50000000

# ── Shell integration ────────────────────────────────────────────────
# ssh-terminfo/ssh-env: remote hosts understand xterm-ghostty (or fall back to xterm-256color).
shell-integration = zsh
shell-integration-features = ssh-env,ssh-terminfo

auto-update = check

# ── Keybindings ──────────────────────────────────────────────────────
# macOS defaults already cover: ⌘T/⌘N tab/window, ⌘D/⌘⇧D split right/down,
# ⌘⌥←↑↓→ move between splits, ⌘[ / ⌘] prev/next split, ⌘⇧↵ zoom split,
# ⌘⌃= equalize, ⌘1–9 tabs, ⌘F search, ⌘K clear, ⌘↑/⌘↓ jump to prompt,
# ⌘⇧, reload config, ⌘⇧P command palette, ⌘+/⌘-/⌘0 font size.
# No overrides: vim-style ⌘⇧HJKL was rejected because ⌘⇧J is the default
# write_screen_file:paste binding. List all: ghostty +list-keybinds --default
